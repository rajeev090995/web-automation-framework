<?xml version="1.0" encoding="UTF-8" ?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{YYYY-MM-dd HH:mm:ss.SSS} [%t] %level %logger{36} - %msg%n"/>
        </Console>

      <File name="FileLogger" fileName="logs/automation.log" append="false">
            <PatternLayout pattern="%d{YYYY-MM-dd HH:mm:ss.SSS} [%t] %level %logger{36} - %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Root level="info">
          <AppenderRef ref="Console"></AppenderRef>
          <AppenderRef ref="FileLogger"></AppenderRef>
        </Root>
    </Loggers>


</Configuration>

<!--<TRACE (LOOP, PART OF INSTANCE>, DEBUG (COMPLEX CODE , DEV PHASE , INFO , WARN , ERROR , FATAL-->